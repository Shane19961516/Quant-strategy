# 每日微信推送（复制为 .env 后填写，勿提交 .env）
# cp .env.example .env

# ===== 必填：至少一个推送渠道 =====
# 推荐 PushPlus：https://www.pushplus.plus/ 微信扫码关注后获取 token
PUSHPLUS_TOKEN=
# wechat=微信模板/公众号推送；sms=短信（需在 PushPlus 绑定手机且有积分）
PUSHPLUS_CHANNEL=wechat
# PUSHPLUS_TOPIC=

# 可选：Server酱 https://sct.ftqq.com/
# SERVERCHAN_SENDKEY=

# 可选：企业微信群机器人 Webhook
# WECOM_WEBHOOK=

# 消息抬头展示用手机号（不能单靠手机号直发微信）
WECHAT_PHONE=15111101843

# 每次推送前强制刷新行情
NOTIFY_FORCE_DOWNLOAD=1
